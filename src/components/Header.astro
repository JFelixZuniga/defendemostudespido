---
import Icon from './Icon.astro';
import { services, waLink } from '../data/services';

interface Props {
  transparentAtTop?: boolean;
}
const { transparentAtTop = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));

const MENU_PATH = '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>';
const CLOSE_PATH = '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>';
const WA_PATH =
  '<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.42 1.31-1.95 1.35-.5.05-1.13.24-3.66-.77-3.08-1.24-5.06-4.4-5.21-4.6-.15-.2-1.25-1.66-1.25-3.17 0-1.51.79-2.25 1.07-2.56.28-.31.61-.38.81-.38.2 0 .41 0 .58.01.19.01.44-.07.68.52.24.6.83 2.06.9 2.21.07.15.12.32.02.52-.1.2-.15.32-.29.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.75 1.24 1.61 2 1.11.99 2.05 1.29 2.34 1.44.29.15.46.12.63-.07.17-.2.72-.84.91-1.13.19-.29.39-.24.65-.15.27.1 1.71.81 2 .96.29.15.48.22.55.34.07.12.07.7-.17 1.38z"/>';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 w-full animate-nav-drop border-b border-navy-text/10 bg-cream-light/97 shadow-[0_2px_12px_rgba(8,23,34,0.06)] backdrop-blur-md"
  data-transparent={transparentAtTop ? 'true' : 'false'}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4 md:px-8">
    <a href="/" class="flex flex-shrink-0 items-center gap-1">
      <img src="/uploads/logo-shield-navbar.png" alt="DefendemosTuDespido" class="h-12 w-auto" />
      <span class="whitespace-nowrap font-brand text-sm font-bold sm:text-xl">
        <span class="text-[#081F4B]">Defendemos</span><span class="text-[#EAA012]">Tu</span><span class="text-[#081F4B]">Despido</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      <a href="/" class:list={["text-sm font-semibold uppercase tracking-wider hover:text-gold", isActive('/') && path === '/' ? 'text-gold-dark' : 'text-navy-text']}>Inicio</a>
      <a href="/nosotros" class:list={["text-sm font-semibold uppercase tracking-wider hover:text-gold", isActive('/nosotros') ? 'text-gold-dark' : 'text-navy-text']}>Nosotros</a>

      <div class="group relative">
        <a href="/servicios" class:list={["inline-flex items-center gap-1.5 text-sm font-semibold uppercase tracking-wider hover:text-gold", isActive('/servicios') || isActive('/servicio') ? 'text-gold-dark' : 'text-navy-text']}>
          Servicios <span class="text-[10px] text-gold">▼</span>
        </a>
        <div class="invisible absolute left-1/2 top-full w-[340px] -translate-x-1/2 pt-3.5 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100">
          <div class="rounded-xl border border-gold/25 bg-navy p-2.5 shadow-[0_24px_50px_rgba(8,23,34,0.5)]">
            <a href="/servicios" class="mb-1 block rounded-lg border-b border-white/10 px-3.5 py-2.5 text-sm font-bold text-gold-light hover:bg-gold/10 hover:text-cream-light">Ver todos los servicios</a>
            {services.map((s) => (
              <a href={`/servicio/${s.slug}`} class="block rounded-lg px-3.5 py-2.5 text-sm leading-tight text-[#d7ddda] hover:bg-gold/10 hover:text-cream-light">{s.navLabel}</a>
            ))}
          </div>
        </div>
      </div>

      <a href="/contacto" class:list={["text-sm font-semibold uppercase tracking-wider hover:text-gold", isActive('/contacto') ? 'text-gold-dark' : 'text-navy-text']}>Contacto</a>
      <a href="/calculadora" class:list={["text-sm font-semibold uppercase tracking-wider hover:text-gold", isActive('/calculadora') ? 'text-gold-dark' : 'text-navy-text']}>Calcular Finiquito</a>
    </nav>

    <button id="drawer-open" aria-label="Abrir menú" class="flex h-11 w-11 items-center justify-center rounded-[11px] border border-navy-text/15 bg-white lg:hidden">
      <Icon path={MENU_PATH} class="h-[22px] w-[22px] text-navy-text" strokeWidth={2} />
    </button>

    <a href={waLink} target="_blank" rel="noopener noreferrer" class="hidden items-center gap-2 whitespace-nowrap rounded-lg bg-green px-5 py-2.5 text-sm font-bold text-white shadow-[0_6px_18px_rgba(37,163,90,0.35)] hover:bg-green-dark lg:inline-flex">
      <Icon path={WA_PATH} fill="currentColor" class="h-[18px] w-[18px]" />
      Evaluación Gratuita
    </a>
  </div>
</header>

<!-- MOBILE DRAWER -->
<div id="drawer-scrim" class="fixed inset-0 z-[59] bg-navy-dark/50 opacity-0 invisible backdrop-blur-[2px] transition-opacity duration-300"></div>
<div id="drawer-panel" class="fixed inset-y-0 right-0 z-[60] flex w-[min(88vw,380px)] -translate-x-0 translate-x-full flex-col bg-cream-light shadow-[-18px_0_50px_rgba(8,23,34,0.35)] transition-transform duration-300">
  <div class="flex items-center justify-between gap-4 border-b border-navy-text/10 px-5 py-4">
  <div class="flex flex-shrink-0 items-center gap-1">
    <img src="/uploads/logo-shield-navbar.png" alt="DefendemosTuDespido" class="h-12 w-auto" />
    <span class="whitespace-nowrap font-brand text-sm font-bold">
      <span class="text-[#081F4B]">Defendemos</span><span class="text-[#EAA012]">Tu</span><span class="text-[#081F4B]">Despido</span>
    </span>
  </div>
    <button id="drawer-close" aria-label="Cerrar menú" class="flex h-11 w-11 items-center justify-center rounded-[11px] border border-navy-text/15 bg-white">
      <Icon path={CLOSE_PATH} class="h-5 w-5 text-navy-text" strokeWidth={2.2} />
    </button>
  </div>
  <div class="flex-1 overflow-y-auto px-5 pb-6 pt-2.5">
    <a href="/" class="flex min-h-[52px] items-center border-b border-[#efe9dc] text-base font-semibold uppercase tracking-wide text-navy-text">Inicio</a>
    <a href="/nosotros" class="flex min-h-[52px] items-center border-b border-[#efe9dc] text-base font-semibold uppercase tracking-wide text-navy-text">Nosotros</a>
    <div data-drawer-svc data-open="false" class="border-b border-[#efe9dc]">
      <button id="drawer-svc-toggle" class="flex min-h-[52px] w-full items-center justify-between bg-transparent text-left text-base font-semibold uppercase tracking-wide text-navy-text">
        Servicios
        <span class="faq-chevron flex-shrink-0 text-2xl text-gold transition-transform">+</span>
      </button>
      <div class="faq-row">
        <div>
          <div class="flex flex-col gap-0 py-1.5">
            <a href="/servicios" class="flex min-h-[46px] items-center text-[15px] font-bold text-gold-dark">Ver todos los servicios</a>
            {services.map((s) => (
              <a href={`/servicio/${s.slug}`} class="flex min-h-[46px] items-center text-[15px] leading-snug text-[#41525a]">{s.navLabel}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
    <a href="/contacto" class="flex min-h-[52px] items-center border-b border-[#efe9dc] text-base font-semibold uppercase tracking-wide text-navy-text">Contacto</a>
    <a href="/calculadora" class="flex min-h-[52px] items-center border-b border-[#efe9dc] text-base font-semibold uppercase tracking-wide text-navy-text">Calcular Finiquito</a>
    <a href={waLink} target="_blank" rel="noopener noreferrer" class="mt-6 flex min-h-[56px] items-center justify-center gap-3 rounded-[11px] bg-green text-base font-bold text-white shadow-[0_10px_24px_rgba(37,163,90,0.3)]">
      <Icon path={WA_PATH} fill="currentColor" class="h-5 w-5" />
      Evaluación gratuita
    </a>
    <p class="mt-4 text-sm leading-relaxed text-[#8593a0]">Lun a Vie, 8:30 a 18:30 hrs · Atención en todo Chile</p>
  </div>
</div>

<script>
  const openBtn = document.getElementById('drawer-open');
  const closeBtn = document.getElementById('drawer-close');
  const scrim = document.getElementById('drawer-scrim');
  const panel = document.getElementById('drawer-panel');
  const svcToggle = document.getElementById('drawer-svc-toggle');
  const svcWrapper = document.querySelector('[data-drawer-svc]');

  function openDrawer() {
    scrim?.classList.remove('opacity-0', 'invisible');
    panel?.classList.remove('translate-x-full');
  }
  function closeDrawer() {
    scrim?.classList.add('opacity-0', 'invisible');
    panel?.classList.add('translate-x-full');
    svcWrapper?.setAttribute('data-open', 'false');
  }
  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  scrim?.addEventListener('click', closeDrawer);
  svcToggle?.addEventListener('click', () => {
    const open = svcWrapper?.getAttribute('data-open') === 'true';
    svcWrapper?.setAttribute('data-open', open ? 'false' : 'true');
  });

  // Sticky header shrink/shadow on scroll (mirrors the source's animated header).
  const header = document.getElementById('site-header');
  if (header?.dataset.transparent === 'true') {
    const onScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add('shadow-[0_10px_30px_rgba(8,23,34,0.14)]');
        header.classList.remove('shadow-[0_2px_12px_rgba(8,23,34,0.06)]');
      } else {
        header.classList.remove('shadow-[0_10px_30px_rgba(8,23,34,0.14)]');
        header.classList.add('shadow-[0_2px_12px_rgba(8,23,34,0.06)]');
      }
    };
    document.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
