---
interface Props {
  path: string;
  class?: string;
  fill?: 'none' | 'currentColor';
  strokeWidth?: number;
}
const { path, class: className = 'w-5 h-5', fill = 'none', strokeWidth = 1.9 } = Astro.props;
---
{fill === 'none' ? (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" set:html={path} />
) : (
  <svg viewBox="0 0 24 24" class={className} fill="currentColor" set:html={path} />
)}
