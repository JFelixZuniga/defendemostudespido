---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { services, waLink } from '../data/services';

const destinos = [
  { href: '/calculadora', title: 'Calcular mi finiquito', desc: 'Estima en 30 segundos cuánto podría corresponderte por años de servicio, aviso previo y vacaciones.', cta: 'Ir a la calculadora', icon: '<circle cx="12" cy="12" r="9"/><path d="M15 9.5a2.5 2.5 0 0 0-2.5-1.5h-1a2 2 0 0 0 0 4h1a2 2 0 0 1 0 4h-1A2.5 2.5 0 0 1 9 14.5"/><path d="M12 6v2"/><path d="M12 16v2"/>' },
  { href: '/servicios', title: 'Ver todos los servicios', desc: 'Despido injustificado, tutela laboral, autodespido, nulidad, accidentes, finiquito y comparendos.', cta: 'Ver servicios', icon: '<path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/>' },
  { href: '/contacto', title: 'Contactar al estudio', desc: 'Cuéntanos tu caso por el formulario y un abogado especialista te responde sin costo.', cta: 'Escribir al estudio', icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' },
];

const WA_ICON = '<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.42 1.31-1.95 1.35-.5.05-1.13.24-3.66-.77-3.08-1.24-5.06-4.4-5.21-4.6-.15-.2-1.25-1.66-1.25-3.17 0-1.51.79-2.25 1.07-2.56.28-.31.61-.38.81-.38.2 0 .41 0 .58.01.19.01.44-.07.68.52.24.6.83 2.06.9 2.21.07.15.12.32.02.52-.1.2-.15.32-.29.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.75 1.24 1.61 2 1.11.99 2.05 1.29 2.34 1.44.29.15.46.12.63-.07.17-.2.72-.84.91-1.13.19-.29.39-.24.65-.15.27.1 1.71.81 2 .96.29.15.48.22.55.34.07.12.07.7-.17 1.38z"/>';
const ARROW_LEFT = '<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>';
---

<Layout title="Página no encontrada" description="La página que buscas ya no existe." noindex>
  <section class="bg-gradient-to-br from-navy-dark via-[#0a1c2a] to-navy-dark">
    <div class="mx-auto max-w-4xl px-6 py-20 pb-22 md:px-8">
      <div class="max-w-2xl">
        <div class="mb-6.5 flex flex-wrap items-center gap-4">
          <span class="font-heading text-6xl font-extrabold leading-none tracking-tight text-gold-light">404</span>
          <span class="h-11 w-px bg-gold/35"></span>
          <span class="text-sm font-bold uppercase tracking-widest text-[#8fa0a7]">Página no encontrada</span>
        </div>
        <h1 class="mb-4 font-heading text-3xl font-bold leading-tight text-cream-light md:text-[46px]">Esta página ya no existe, pero tu caso sí.</h1>
        <p class="mb-8 text-lg leading-relaxed text-[#c3d1c8] md:text-xl">
          Puede que el enlace esté mal escrito o que hayamos movido el contenido. Si llegaste buscando ayuda por un despido, no pierdas tiempo: los plazos legales siguen corriendo.
        </p>
        <div class="flex flex-wrap items-center gap-3.5">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-xl bg-green px-7 py-5 text-lg font-bold text-white shadow-[0_14px_34px_rgba(37,163,90,0.4)] hover:bg-green-dark">
            <Icon path={WA_ICON} fill="currentColor" class="h-6.5 w-6.5" />
            Consulta gratis
          </a>
          <a href="/" class="inline-flex items-center gap-2.5 whitespace-nowrap rounded-xl border border-gold/35 bg-white/6 px-7 py-5 text-lg font-bold text-cream-light hover:bg-white/12">
            <Icon path={ARROW_LEFT} class="h-5 w-5" strokeWidth={2.1} />
            Volver al inicio
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 pb-10 md:px-8">
    <div class="mb-9 max-w-2xl">
      <div class="mb-3 text-[13px] font-bold tracking-widest text-gold-dark">QUIZÁS BUSCABAS</div>
      <h2 class="font-heading text-3xl font-bold leading-tight text-navy md:text-4xl">Las páginas que más consultan los trabajadores</h2>
    </div>
    <div class="grid grid-cols-1 gap-4.5 sm:grid-cols-3">
      {destinos.map((d) => (
        <a href={d.href} class="group flex flex-col rounded-2xl border border-[#e8e2d5] bg-white p-7 shadow-[0_4px_14px_rgba(12,34,49,0.04)] transition-all hover:-translate-y-1 hover:border-gold hover:shadow-[0_18px_40px_rgba(12,34,49,0.11)]">
          <div class="mb-4 flex h-11.5 w-11.5 items-center justify-center rounded-xl border border-[#e3dac6] bg-[#f4efe3] text-gold-dark">
            <Icon path={d.icon} class="h-5.5 w-5.5" />
          </div>
          <h3 class="mb-2 font-heading text-xl font-bold text-navy">{d.title}</h3>
          <p class="mb-4.5 text-[15.5px] leading-relaxed text-[#5a6a70]">{d.desc}</p>
          <span class="mt-auto inline-flex items-center gap-2 text-sm font-bold text-gold-dark">
            {d.cta}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-22 pt-3.5 md:px-8">
    <div class="rounded-2xl bg-navy p-9 md:p-11.5">
      <h2 class="mb-6.5 font-heading text-3xl font-bold text-cream-light md:text-4xl">Nuestros servicios</h2>
      <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <a href={`/servicio/${s.slug}`} class="flex min-h-[52px] items-center gap-3 rounded-lg border border-gold/20 px-4 py-3 text-[15.5px] leading-snug text-[#d7ddda] hover:bg-gold/12 hover:text-cream-light">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold"></span>
            {s.navLabel}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
